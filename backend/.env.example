PORT=3000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# Secret for signing access tokens (at least 32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME

# Origins allowed to call the API with credentials, comma-separated
CORS_ORIGIN=http://localhost:5173

# Secret for deriving collection share link ids (at least 32 bytes, separate from JWT_SECRET).
# Changing it invalidates every share link. Generate one the same way as JWT_SECRET.
SHARE_LINK_SECRET=CHANGE_ME

# Set when running behind a reverse proxy or load balancer: the number of proxies in front of the
# server. Rate limits then count the real client address instead of the proxy's.
# TRUST_PROXY=1

# --- Saved images ------------------------------------------------------------------------------
# Images saved from these hosts (subdomains included) are downloaded and stored by this server;
# images from anywhere else are saved as links. This list is what stops the server being used to
# fetch internal addresses, so keep it narrow. Pixabay's terms require storing copies.
MEDIA_ALLOWED_HOSTS=pixabay.com

# Largest image accepted (bytes), and how long a download may take (ms)
# MEDIA_MAX_BYTES=10485760
# MEDIA_FETCH_TIMEOUT_MS=10000

# Where copies are stored: local = MEDIA_DIR on this server, served at MEDIA_BASE_URL
#                          s3    = any S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, ...)
STORAGE_DRIVER=local
# MEDIA_DIR=media
# MEDIA_BASE_URL=http://localhost:3000/media

# Required when STORAGE_DRIVER=s3 (the server will not start without them).
# S3_ENDPOINT is only needed for services other than AWS.
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BASE_URL=https://cdn.example.com

# --- Image search ------------------------------------------------------------------------------
# Pixabay API key, kept on the server (the server will not start without it).
# Get a free one at https://pixabay.com/api/docs/ after signing up.
PIXABAY_API_KEY=CHANGE_ME
