PORT=3000

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/postgres

# Secret for signing access tokens (at least 32 bytes). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME

# Origins allowed to call the API with credentials, comma-separated
CORS_ORIGIN=http://localhost:5173

# Secret for deriving collection share link ids (at least 32 bytes, separate from JWT_SECRET).
# Changing it invalidates every share link. Generate one the same way as JWT_SECRET.
SHARE_LINK_SECRET=CHANGE_ME

# Set when running behind a reverse proxy or load balancer: the number of proxies in front of the
# server. Rate limits then count the real client address instead of the proxy's.
# TRUST_PROXY=1
